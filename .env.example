# ---------------------------------------------------------------------------
# ValoreaX — root environment for Docker Compose
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Postgres (used by the `db` service in docker-compose) ---
POSTGRES_USER=valorea
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=valorea

# --- Backend ---
# When running under Docker Compose the backend talks to the `db` service.
DATABASE_URL=postgresql+psycopg2://valorea:change_me_in_local_env@db:5432/valorea
FLASK_ENV=development
SECRET_KEY=change_me_dev_only

# Data provider selection: "mock" (offline, deterministic, default) or "sec_edgar" (live SEC XBRL)
SEC_PROVIDER=mock
# SEC requires a descriptive User-Agent with contact info per their fair-access policy.
SEC_USER_AGENT=ValoreaX-Research your-email@example.com

# Cache time-to-live in seconds (see docs/CACHING.md)
CACHE_TTL_COMPANY_FACTS=86400
CACHE_TTL_MARKET_PRICE=900

# --- Frontend ---
# Base URL the React app uses to reach the API (see frontend/.env.example)
VITE_API_BASE_URL=http://localhost:5001/api/v1
