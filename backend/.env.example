# ---------------------------------------------------------------------------
# Backend-only environment (for running the Flask app outside Docker).
# Copy to `.env`. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Local development defaults to a SQLite file — no database server required.
# For Postgres:  postgresql+psycopg2://user:pass@localhost:5432/valorea
DATABASE_URL=sqlite:///valorea.sqlite3

FLASK_ENV=development
SECRET_KEY=change_me_dev_only

# Same Supabase project as the frontend. Only the URL is needed for JWT verification.
SUPABASE_URL=
# Apply migrations with `alembic upgrade head`; do not create/alter tables on web startup.
AUTO_CREATE_SCHEMA=false

# Data provider: "mock" (offline, deterministic) or "sec_edgar" (live SEC XBRL, no key required)
SEC_PROVIDER=sec_edgar
# SEC fair-access policy requires a descriptive User-Agent containing contact info.
SEC_USER_AGENT=ValoreaX-Research your-email@example.com

# Market data: mock is deterministic sample data. Set twelve_data and a real key for recent daily closes.
MARKET_DATA_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=
MARKET_BENCHMARK_TICKER=XLV
MARKET_PRICE_LOOKBACK_DAYS=90
MARKET_EVENT_WINDOW_TRADING_DAYS=5

# Catalyst ingestion: "manual" (CRUD only, offline), "mock" (deterministic sample),
# or "clinicaltrials" (live keyless ClinicalTrials.gov v2 API). Only "clinicaltrials"
# makes outbound calls. The adapter ingests trial DATES as pending catalysts; it never
# infers clinical outcomes (those stay manual).
CATALYST_PROVIDER=clinicaltrials
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
# Sent as User-Agent to ClinicalTrials.gov (use real contact info, like SEC_USER_AGENT).
CLINICALTRIALS_USER_AGENT=ValoreaX-Research your-email@example.com
CLINICALTRIALS_TIMEOUT_SECONDS=20
CLINICALTRIALS_MAX_STUDIES=25

# Analyst coverage: "mock" (deterministic sample) or "fmp" (live Financial Modeling
# Prep — needs an API key). Drives the signal's analyst component + auto-fills upside.
ANALYST_PROVIDER=fmp
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com
FMP_TIMEOUT_SECONDS=20

# News: "mock" (deterministic sample) or "finnhub" (live company-news; free key).
# Sentiment/impact/topic tags are a transparent keyword HEURISTIC (labeled as such),
# used where the provider supplies no sentiment — never presented as verified.
NEWS_PROVIDER=finnhub
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_TIMEOUT_SECONDS=20
NEWS_LOOKBACK_DAYS=30
NEWS_MAX_ARTICLES=40
CACHE_TTL_NEWS=3600

# Cache TTLs in seconds (see docs/CACHING.md)
CACHE_TTL_COMPANY_FACTS=86400
CACHE_TTL_MARKET_PRICE=900
CACHE_TTL_CLINICAL_TRIALS=21600
CACHE_TTL_ANALYST=21600

# CORS origin allowed to call the API (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Dashboard research (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Clinical ML: optional evaluated JSON artifact; leave empty until trained.
CLINICAL_ML_MODEL_PATH=
CLINICAL_ML_MAX_STUDIES=100
