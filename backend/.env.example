# ---------------------------------------------------------------------------
# Backend-only environment (for running the Flask app outside Docker).
# Copy to `.env`. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Local development defaults to a SQLite file — no database server required.
# For Postgres:  postgresql+psycopg2://user:pass@localhost:5432/valorea
DATABASE_URL=sqlite:///valorea.sqlite3

FLASK_ENV=development
SECRET_KEY=change_me_dev_only

# Data provider: "mock" (offline, deterministic) or "sec_edgar" (live SEC XBRL, no key required)
SEC_PROVIDER=mock
# SEC fair-access policy requires a descriptive User-Agent containing contact info.
SEC_USER_AGENT=ValoreaX-Research your-email@example.com

# Market data: mock is deterministic sample data. Set twelve_data and a real key for recent daily closes.
MARKET_DATA_PROVIDER=mock
TWELVE_DATA_API_KEY=
MARKET_BENCHMARK_TICKER=XLV
MARKET_PRICE_LOOKBACK_DAYS=90
MARKET_EVENT_WINDOW_TRADING_DAYS=5

# Cache TTLs in seconds (see docs/CACHING.md)
CACHE_TTL_COMPANY_FACTS=86400
CACHE_TTL_MARKET_PRICE=900

# CORS origin allowed to call the API (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173
